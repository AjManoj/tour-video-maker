<?xml version="1.0" encoding="utf-8"?>
<!--
  Allows plain http so the app can reach the laptop server on the home Wi-Fi
  (e.g. http://192.168.1.20:8765). Android cannot whitelist IP ranges, so
  cleartext is allowed app-wide; the app only talks to addresses you type in
  Settings -> Engines. Remove cleartextTrafficPermitted for a release build
  that never uses a LAN server.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
